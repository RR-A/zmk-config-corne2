#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | CAD  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | ALT-TAB |
            // | LCTRL|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  | BKSP|  RCTRL  |
            // | LSHFT|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  | ENT |   NONE  |
            //                    | NONE| LWR | SHFT|   | SPC | RSE  | NONE|

            display-name = "Base";
            bindings = <
&kp ESCAPE     &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P      &kp DEL
&kp TAB        &kp A  &kp S  &kp D  &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp BSPC   &kp RIGHT_ALT
&kp LC(LCTRL)  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp ENTER  &kp RCTRL
                             &none  &mo 1  &kp LSHFT    &kp SPACE  &mo 2  &none
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |      |

            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp GRAVE      &kp TILDE     &trans
&trans      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp SLASH      &kp MINUS      &kp EQUAL     &kp SEMICOLON  &kp COLON     &trans
&trans      &trans        &trans        &trans        &trans        &trans          &kp BACKSLASH  &kp UNDER      &kp PLUS      &kp PIPE       &kp QUESTION  &trans
                                        &trans        &trans        &trans          &trans         &trans         &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  * |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  /  |  -  |  =  |  :  |  ;  |      |

            display-name = "Raise";
            bindings = <
&trans  &kp EXCL           &kp AT             &kp HASH         &kp DLLR               &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR   &kp RPAR   &kp BSPC
&trans  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &trans       &kp SLASH  &kp MINUS  &kp EQUAL        &kp COLON  &kp SEMI   &trans
&trans  &kp SQT            &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &trans       &kp BSLH   &kp UNDER  &kp PLUS         &kp PIPE   &kp QMARK  &trans
                                              &trans           &trans                 &trans       &trans     &trans     &trans
            >;
        };
    };
};
