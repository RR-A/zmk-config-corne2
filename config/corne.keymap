#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        alpha: alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U03B1>;
        };
        beta: beta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U03B2>;
        };
        delta_cap: delta_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U0394>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LC(LA(DEL)) &kp Q &kp W &kp E &kp R &kp T                &kp Y &kp U  &kp I     &kp O   &kp P        &kp LA(TAB)
&none           &kp A &kp S &kp D &kp F &kp G                &kp H &kp J  &kp K     &kp L   &kp BSPC     &none
&none           &kp Z &kp X &kp C &kp V &kp B                &kp N &kp M  &kp COMMA &kp DOT &kp ENTER    &kp RCTRL
                        &none &mo 1 &kp LSHFT           &kp SPACE &mo 2 &mo 3
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &trans
&trans     &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                     &trans &trans &trans                     &trans &trans &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL &trans   &trans &trans   &trans   &trans      &kp SLASH &kp MINUS &kp EQUAL       &kp COLON &kp SEMI &trans
&trans    &trans   &trans &trans   &trans   &trans      &kp BSLH  &kp UNDER &kp PLUS        &kp PIPE  &kp QMARK &trans
                                   &trans &trans &trans   &trans &trans &trans
            >;
        };

        greek_layer {
            display-name = "Greek";
            bindings = <
&none &none  &none  &none  &none  &none    &none &none &none &none &none &none
&none &alpha &beta  &delta_cap &none &none    &none &none &none &none &none &none
&none &none  &none  &none  &none  &none    &none &none &none &none &none &none
                          &trans &trans &trans    &trans &trans &trans
            >;
        };
    };
};
