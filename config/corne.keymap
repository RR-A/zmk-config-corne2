#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Macros for Greek Letters

/ {
    macros {
        alpha: alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U03B1>;
        };

        beta: beta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U03B2>;
        };

        delta_cap: delta_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp U7B &kp U0394>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // | CAD |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | ALT-TAB |
            // | NONE|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  '  |   NONE  |
            // | NONE|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |   NONE  |
            //                    | GUI | LWR | GREEK |   | SPC | RSE | ALT |

            bindings = <
&kp LC(LA(DEL))  &kp Q  &kp W  &kp E  &kp R  &kp T             &kp Y      &kp U  &kp I      &kp O    &kp P          &kp LA(TAB)
&none            &kp A  &kp S  &kp D  &kp F  &kp G             &kp H      &kp J  &kp K      &kp L    &kp BACKSPACE  &none
&none            &kp Z  &kp X  &kp C  &kp V  &kp B             &kp N      &kp M  &kp COMMA  &kp DOT  &kp ENTER      &none
                               &none  &mo 1  &kp LEFT_SHIFT    &kp SPACE  &mo 2  &none
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET      &kp AMPS        &kp KP_MULTIPLY  &kp LPAR   &kp RPAR       &trans
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp SLASH      &kp MINUS       &kp EQUAL        &kp COLON  &kp SEMICOLON  &trans
&trans     &trans    &trans  &trans    &trans    &trans       &kp BACKSLASH  &kp UNDERSCORE  &kp PLUS         &kp PIPE   &kp QUESTION   &trans
                             &trans    &trans    &trans       &trans         &trans          &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none   &kp EXCL           &kp AT             &kp POUND        &kp DOLLAR               &kp PERCENT    &none   &kp NUMBER_1  &kp N2  &kp NUMBER_3  &none   &none
&trans  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp KP_LEFT_PARENTHESIS  &trans         &trans  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &trans  &trans
&trans  &kp APOS           &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS    &trans         &trans  &kp N7        &kp N8  &kp N9        &trans  &trans
                                              &trans           &trans                   &trans         &trans  &trans        &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans  &trans     &trans  &trans
                                        &trans        &trans        &trans          &trans    &trans    &trans
            >;
        };
    };
};
